# misc scripts that shouldn't be published
_hidden

# files autogenerated by testing suite
.monero
.monero-temp
.bitcoin
.eth
*.sqlite

# go standard gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env